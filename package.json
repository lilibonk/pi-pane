{
  "name": "pi-pane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Open the running pi TUI session in a browser: live mirror, prompts with images, optional HTTPS access from other devices",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./dist/extension/index.js"
    ]
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && tsc -p tsconfig.extension.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "m0:smoke": "node scripts/m0-smoke.mjs",
    "m0:browser": "node scripts/m0-browser.mjs",
    "m0:lifecycle": "node scripts/m0-lifecycle.mjs",
    "m0:boundaries": "node scripts/m0-boundaries.mjs",
    "m0:projection": "node scripts/m0-projection-extra.mjs",
    "m0:performance": "node scripts/m0-performance.mjs",
    "m1:render": "node scripts/m1-render.mjs",
    "m1:a6": "node scripts/m1-a6.mjs",
    "prepack": "npm run build",
    "m2:images": "node scripts/m2-images.mjs",
    "m2:external": "node scripts/m2-external.mjs",
    "m2:install": "node scripts/m2-install.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "dependencies": {
    "qrcode-generator": "2.0.4",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@shikijs/langs": "4.5.0",
    "@types/node": "24.7.0",
    "@types/ws": "8.18.1",
    "dompurify": "3.4.16",
    "jsqr": "1.4.0",
    "marked": "18.1.0",
    "playwright": "1.55.1",
    "preact": "10.29.8",
    "shiki": "4.5.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "zustand": "5.0.8"
  },
  "files": [
    "dist",
    "web-dist",
    "README.md",
    "docs/design.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  }
}
