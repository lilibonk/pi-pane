{
  "name": "@lilibonk/pi-pane",
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "description": "Hand the current pi TUI session to a foreground browser workbench, with RPC-owned conversations and optional HTTPS access",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lilibonk/pi-pane.git"
  },
  "homepage": "https://github.com/lilibonk/pi-pane#readme",
  "bugs": {
    "url": "https://github.com/lilibonk/pi-pane/issues"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./dist/extension/index.js"
    ],
    "themes": [
      "./themes/*.json"
    ],
    "image": "https://raw.githubusercontent.com/lilibonk/pi-pane/main/docs/preview.png"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && tsc -p tsconfig.extension.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "m0:smoke": "node scripts/m0-smoke.mjs",
    "m0:browser": "node scripts/m0-browser.mjs",
    "m0:lifecycle": "node scripts/m0-lifecycle.mjs",
    "m0:boundaries": "node scripts/m0-boundaries.mjs",
    "m0:projection": "node scripts/m0-projection-extra.mjs",
    "m0:performance": "node scripts/m0-performance.mjs",
    "m1:render": "node scripts/m1-render.mjs",
    "m1:a6": "node scripts/m1-a6.mjs",
    "prepack": "npm run build",
    "m2:images": "node scripts/m2-images.mjs",
    "m2:external": "node scripts/m2-external.mjs",
    "m2:install": "node scripts/m2-install.mjs",
    "m2:real-model": "node scripts/m2-real-model.mjs",
    "m3:workbench": "node scripts/m3-workbench.mjs",
    "m3:handoff": "node scripts/m3-handoff.mjs",
    "m31:runtime": "node --import tsx scripts/m31-runtime.mjs",
    "m31:projects": "node --import tsx scripts/m31-projects.mjs",
    "m31:auth": "node --import tsx scripts/m31-auth.mjs",
    "m31:auth-real": "node --import tsx scripts/m31-auth-real.mjs",
    "m31:gates": "node --import tsx scripts/m31-g1.mjs && node --import tsx scripts/m31-g2.mjs && node --import tsx scripts/m31-g3.mjs && node --import tsx scripts/m31-g4g5.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": ">=1.1.0 <2"
  },
  "dependencies": {
    "qrcode-generator": "2.0.4",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@shikijs/langs": "4.5.0",
    "@types/node": "24.7.0",
    "@types/ws": "8.18.1",
    "dompurify": "3.4.16",
    "jsqr": "1.4.0",
    "marked": "18.1.0",
    "playwright": "1.55.1",
    "preact": "10.29.8",
    "shiki": "4.5.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "zustand": "5.0.8"
  },
  "files": [
    "dist",
    "web-dist",
    "themes",
    "README.md",
    "docs/design.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  }
}
